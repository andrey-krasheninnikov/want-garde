[Unit]
Description=Want Garde read-only fail2ban connection
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/local/lib/want-garde/current/want-garde-helper --serve-read --daemon-uid-file /etc/want-garde-helper/daemon-uid
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=6
TimeoutStopSec=1
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
InaccessiblePaths=-/etc/want-garde -/var/lib/want-garde -/var/backups/want-garde
