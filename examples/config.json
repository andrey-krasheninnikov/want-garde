{
  "server_id": "my-vps",
  "bot_token_file": "/etc/want-garde/telegram-token",
  "state_dir": "/var/lib/want-garde",
  "default_locale": "ru",
  "owner_user_id": null,
  "notifications": {
    "private": [],
    "forums": []
  },
  "ssh": {
    "mode": "auto"
  },
  "services": {
    "units": [],
    "interval_seconds": 60
  },
  "ports": {
    "enabled": true,
    "interval_seconds": 120
  },
  "xui": {
    "enabled": false,
    "interval_seconds": 30,
    "client_disconnect_after_seconds": 180,
    "helper_socket": "/run/want-garde-xui.sock"
  },
  "retention": {
    "event_days": 30,
    "action_audit_days": 30,
    "process_audit_days": 7,
    "result_hours": 24,
    "database_mib": 64,
    "pending_deliveries": 10000,
    "result_mib": 32
  },
  "geoip": {
    "enabled": false,
    "token_file": null
  }
}
