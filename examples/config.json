{
  "server_id": "my-vps",
  "bot_token_file": "/etc/want-garde/telegram-token",
  "state_dir": "/var/lib/want-garde",
  "default_locale": "ru",
  "owner_user_id": null,
  "ssh": {
    "mode": "auto"
  },
  "services": {
    "units": [],
    "interval_seconds": 60
  },
  "ports": {
    "enabled": true,
    "interval_seconds": 120
  },
  "xui": {
    "enabled": false,
    "interval_seconds": 30,
    "client_disconnect_after_seconds": 180,
    "helper_socket": "/run/want-garde-xui.sock"
  },
  "geoip": {
    "enabled": false,
    "token_file": null
  }
}
