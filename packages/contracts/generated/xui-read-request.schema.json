{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XuiReadRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/XuiCheckpoint"
        },
        "type": {
          "type": "string",
          "const": "logs"
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "checkpoint"
      ]
    }
  ],
  "$defs": {
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "XuiCheckpoint": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XuiFilePosition"
          }
        },
        "journal_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "journal_started": {
          "type": "boolean"
        },
        "journal_time": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "journal_started",
        "journal_time",
        "files"
      ]
    },
    "XuiFilePosition": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string"
        },
        "device": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "discard": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "slot": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "slot",
        "device",
        "inode",
        "generation",
        "offset",
        "anchor",
        "discard"
      ]
    }
  }
}
