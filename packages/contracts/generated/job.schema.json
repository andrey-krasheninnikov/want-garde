{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "request_id": {
      "$ref": "#/$defs/Id"
    },
    "server_id": {
      "$ref": "#/$defs/Id"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "request_id",
    "server_id",
    "state"
  ],
  "$defs": {
    "BansSnapshot": {
      "type": "object",
      "properties": {
        "jails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JailBans"
          }
        },
        "log_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "partial": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "observed_at",
        "jails",
        "partial"
      ]
    },
    "ByteUsage": {
      "type": "object",
      "properties": {
        "available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "available_bytes"
      ]
    },
    "ContractError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message_key": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message_key"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "access_denied",
        "unavailable",
        "conflict",
        "audit_unavailable",
        "not_implemented",
        "internal"
      ]
    },
    "HostSnapshot": {
      "type": "object",
      "properties": {
        "cpu_usage_percent": {
          "$ref": "#/$defs/Measurement3"
        },
        "hostname": {
          "$ref": "#/$defs/Measurement"
        },
        "kernel": {
          "$ref": "#/$defs/Measurement"
        },
        "load_average": {
          "$ref": "#/$defs/Measurement4"
        },
        "memory": {
          "$ref": "#/$defs/Measurement5"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "os": {
          "$ref": "#/$defs/Measurement"
        },
        "root_disk": {
          "$ref": "#/$defs/Measurement5"
        },
        "uptime_seconds": {
          "$ref": "#/$defs/Measurement2"
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "hostname",
        "os",
        "kernel",
        "uptime_seconds",
        "cpu_usage_percent",
        "load_average",
        "memory",
        "root_disk"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "JailBans": {
      "type": "object",
      "properties": {
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_banned": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "jail": {
          "$ref": "#/$defs/Id"
        },
        "reason_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "jail",
        "addresses"
      ]
    },
    "JobState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "awaiting_approval"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/OperationResult"
            },
            "type": {
              "type": "string",
              "const": "succeeded"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ContractError"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "needs_reconciliation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/ByteUsage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "OperationResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "snapshot": {
              "$ref": "#/$defs/BansSnapshot"
            },
            "type": {
              "type": "string",
              "const": "fail2ban_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "snapshot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "product_version": {
              "type": "string"
            },
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "snapshot": {
              "$ref": "#/$defs/HostSnapshot"
            },
            "type": {
              "type": "string",
              "const": "server_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "product_version",
            "snapshot"
          ]
        }
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
