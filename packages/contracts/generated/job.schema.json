{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "request_id": {
      "$ref": "#/$defs/Id"
    },
    "server_id": {
      "$ref": "#/$defs/Id"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "request_id",
    "server_id",
    "state"
  ],
  "$defs": {
    "AddressFamily": {
      "type": "string",
      "enum": [
        "ipv4",
        "ipv6"
      ]
    },
    "BansSnapshot": {
      "type": "object",
      "properties": {
        "jails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JailBans"
          }
        },
        "log_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "partial": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "observed_at",
        "jails",
        "partial"
      ]
    },
    "ByteUsage": {
      "type": "object",
      "properties": {
        "available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "available_bytes"
      ]
    },
    "ContractError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message_key": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message_key"
      ]
    },
    "DiskMeasurement": {
      "type": "object",
      "properties": {
        "inodes": {
          "$ref": "#/$defs/Measurement8"
        },
        "path": {
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/Measurement7"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "space",
        "inodes"
      ]
    },
    "DiskUsage": {
      "type": "object",
      "properties": {
        "available_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "used_bytes",
        "available_bytes"
      ]
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/AddressFamily"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "$ref": "#/$defs/ListenerProtocol"
        }
      },
      "additionalProperties": false,
      "required": [
        "family",
        "protocol",
        "address",
        "port"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "access_denied",
        "unavailable",
        "conflict",
        "audit_unavailable",
        "not_implemented",
        "internal"
      ]
    },
    "HostSnapshot": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "$ref": "#/$defs/Measurement3",
          "default": {
            "reason_key": "source.unavailable",
            "type": "unavailable"
          }
        },
        "cpu_usage_percent": {
          "$ref": "#/$defs/Measurement4"
        },
        "disks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DiskMeasurement"
          }
        },
        "hostname": {
          "$ref": "#/$defs/Measurement2"
        },
        "kernel": {
          "$ref": "#/$defs/Measurement2"
        },
        "load_average": {
          "$ref": "#/$defs/Measurement5"
        },
        "load_per_core": {
          "$ref": "#/$defs/Measurement5",
          "default": {
            "reason_key": "source.unavailable",
            "type": "unavailable"
          }
        },
        "memory": {
          "$ref": "#/$defs/Measurement6"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "os": {
          "$ref": "#/$defs/Measurement2"
        },
        "reboot_required": {
          "$ref": "#/$defs/Measurement9",
          "default": {
            "reason_key": "source.unavailable",
            "type": "unavailable"
          }
        },
        "root_disk": {
          "$ref": "#/$defs/Measurement6"
        },
        "uptime_seconds": {
          "$ref": "#/$defs/Measurement3"
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "hostname",
        "os",
        "kernel",
        "uptime_seconds",
        "cpu_usage_percent",
        "load_average",
        "memory",
        "root_disk"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "InodeUsage": {
      "type": "object",
      "properties": {
        "available": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "total",
        "available"
      ]
    },
    "JailBans": {
      "type": "object",
      "properties": {
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_banned": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "jail": {
          "$ref": "#/$defs/Id"
        },
        "reason_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "jail",
        "addresses"
      ]
    },
    "JobState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "awaiting_approval"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/OperationResult"
            },
            "type": {
              "type": "string",
              "const": "succeeded"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ContractError"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "needs_reconciliation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Listener": {
      "type": "object",
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "ignored": {
          "type": "boolean"
        },
        "process_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "processes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListenerProcess"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "processes",
        "ignored"
      ]
    },
    "ListenerProcess": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pid",
        "name"
      ]
    },
    "ListenerProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "Measurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/ServiceStatus"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement6": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/ByteUsage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/DiskUsage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "$ref": "#/$defs/InodeUsage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "Measurement9": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "available"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "OperationResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "health": {
              "$ref": "#/$defs/ServicesHealth"
            },
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "services_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "health"
          ]
        },
        {
          "type": "object",
          "properties": {
            "health": {
              "$ref": "#/$defs/PortsHealth"
            },
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "ports_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "health"
          ]
        },
        {
          "type": "object",
          "properties": {
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "snapshot": {
              "$ref": "#/$defs/BansSnapshot"
            },
            "type": {
              "type": "string",
              "const": "fail2ban_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "snapshot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "product_version": {
              "type": "string"
            },
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "snapshot": {
              "$ref": "#/$defs/HostSnapshot"
            },
            "type": {
              "type": "string",
              "const": "server_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "product_version",
            "snapshot"
          ]
        }
      ]
    },
    "PortBaseline": {
      "type": "object",
      "properties": {
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          }
        },
        "filter_hash": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "hash",
        "filter_hash",
        "accepted_at",
        "endpoints"
      ]
    },
    "PortsHealth": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          }
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortBaseline"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Endpoint"
          }
        },
        "server_id": {
          "$ref": "#/$defs/Id"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortsSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "suspicious": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuspiciousListener"
          }
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "server_id",
        "enabled",
        "stale",
        "added",
        "removed",
        "suspicious",
        "problems"
      ]
    },
    "PortsSnapshot": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "ephemeral_range": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "ignored_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "listeners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Listener"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "processes_complete": {
          "type": "boolean"
        },
        "range_fallback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "listeners",
        "complete",
        "processes_complete",
        "ignored_count",
        "ephemeral_range",
        "range_fallback"
      ]
    },
    "ServiceObservation": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/Measurement"
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit",
        "state"
      ]
    },
    "ServiceStatus": {
      "type": "object",
      "properties": {
        "active_state": {
          "type": "string"
        },
        "load_state": {
          "type": "string"
        },
        "sub_state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "load_state",
        "active_state",
        "sub_state"
      ]
    },
    "ServicesHealth": {
