{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "request_id": {
      "$ref": "#/$defs/Id"
    },
    "server_id": {
      "$ref": "#/$defs/Id"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "request_id",
    "server_id",
    "state"
  ],
  "$defs": {
    "ContractError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message_key": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message_key"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "access_denied",
        "unavailable",
        "conflict",
        "audit_unavailable",
        "not_implemented",
        "internal"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "JobState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "awaiting_approval"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "running"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/$defs/OperationResult"
            },
            "type": {
              "type": "string",
              "const": "succeeded"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ContractError"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason_key": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "needs_reconciliation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reason_key"
          ]
        }
      ]
    },
    "OperationResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "product_version": {
              "type": "string"
            },
            "server_id": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "server_status"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "server_id",
            "product_version"
          ]
        }
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
