{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryPage",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventSummary"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "events"
  ],
  "$defs": {
    "EventSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_key": {
          "$ref": "#/$defs/Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "observed_at",
        "source",
        "severity",
        "reason_key"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
