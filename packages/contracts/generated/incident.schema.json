{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident",
  "type": "object",
  "properties": {
    "event_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "server_id": {
      "$ref": "#/$defs/Id"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "state": {
      "$ref": "#/$defs/IncidentState"
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "server_id",
    "event_ids",
    "severity",
    "state"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "IncidentState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "$ref": "#/$defs/Id"
            },
            "type": {
              "type": "string",
              "const": "acknowledged"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "by",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "$ref": "#/$defs/Id"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "closed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "by",
            "at",
            "reason"
          ]
        }
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
