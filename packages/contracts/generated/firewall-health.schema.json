{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirewallHealth",
  "type": "object",
  "properties": {
    "backend": {
      "$ref": "#/$defs/FirewallBackend"
    },
    "fail2ban": {
      "$ref": "#/$defs/SourceHealth"
    },
    "firewall": {
      "$ref": "#/$defs/SourceHealth"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "$ref": "#/$defs/Id"
    },
    "version": {
      "$ref": "#/$defs/WireVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "server_id",
    "observed_at",
    "backend",
    "fail2ban",
    "firewall"
  ],
  "$defs": {
    "FirewallBackend": {
      "type": "string",
      "enum": [
        "auto",
        "ufw",
        "firewalld",
        "nftables"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "SourceHealth": {
      "type": "object",
      "properties": {
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverage_started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "gap_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "last_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_gap_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_record_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_id": {
          "$ref": "#/$defs/Id"
        },
        "skipped_records": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/SshSourceKind"
        },
        "state": {
          "$ref": "#/$defs/SshStatus"
        },
        "version": {
          "$ref": "#/$defs/WireVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "server_id",
        "observed_at",
        "source",
        "state",
        "skipped_records",
        "gap_count"
      ]
    },
    "SshSourceKind": {
      "type": "string",
      "enum": [
        "unselected",
        "journald",
        "file"
      ]
    },
    "SshStatus": {
      "type": "string",
      "enum": [
        "starting",
        "healthy",
        "degraded",
        "unavailable"
      ]
    },
    "WireVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    }
  }
}
